---
import '../styles/global.css';
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL, FOUNDER } from '../consts.js';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const { title, description = SITE_DESCRIPTION, noindex = false, schema = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const ogImage = new URL('/og.png', Astro.site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  logo: `${SITE_URL}/logo.png`,
  description: SITE_DESCRIPTION,
  founder: { '@type': 'Person', name: FOUNDER },
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  publisher: { '@id': `${SITE_URL}/#organization` },
};
const jsonLd = [organization, website, ...schema];

const nav = [
  { href: '/how-it-works/', label: 'How it works' },
  { href: '/courses/', label: 'Courses' },
  { href: '/about/', label: 'About' },
  { href: '/faq/', label: 'FAQ' },
];
const legal = [
  { href: '/privacy-policy/', label: 'Privacy policy' },
  { href: '/terms/', label: 'Terms of service' },
  { href: '/earnings-disclaimer/', label: 'Earnings disclaimer' },
  { href: '/refund-policy/', label: 'Refund policy' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}>
  <meta name="theme-color" content="#0A2A30">
  <meta name="color-scheme" content="light dark">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="sitemap" href="/sitemap-index.xml">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content={SITE_NAME}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="The Agency School: start a digital marketing agency from your phone">
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Figtree:wght@400;500;600&display=swap">

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="wrap">
    <header class="top">
      <a class="logo" href="/" aria-label="The Agency School home"><i aria-hidden="true"></i>The Agency School</a>
      <nav class="nav" aria-label="Main">
        {nav.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
        ))}
        <a class="btn" href="/free-book/">Get the free book</a>
      </nav>
    </header>
  </div>

  <main id="main">
    <slot />
  </main>

  <div class="wrap">
    <footer>
      <nav aria-label="Footer">
        {legal.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <span>© {new Date().getFullYear()} The Agency School. All rights reserved.</span>
      <span>Results vary. Income and lifestyle examples reflect the founder's own experience and are not typical. Contractor services are provided by independent contractors, subject to availability.</span>
    </footer>
  </div>
</body>
</html>
