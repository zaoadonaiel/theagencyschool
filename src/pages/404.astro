---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found" description="The page you were looking for doesn't exist. Head back to The Agency School home page." noindex>
  <div class="wrap">
    <div class="page-head center" style="padding-block:80px">
      <p class="eyebrow">Error 404</p>
      <h1>This page doesn't exist</h1>
      <p class="lead" style="margin-inline:auto">It may have moved, or the link may be wrong.</p>
      <p style="margin-top:28px"><a class="btn" href="/">Go to the home page</a></p>
    </div>
  </div>
</Base>
