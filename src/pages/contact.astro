---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, SITE_URL, SITE_NAME } from '../consts.js';

const contact = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${SITE_NAME}`,
  url: `${SITE_URL}/contact/`,
  mainEntity: { '@type': 'Organization', name: SITE_NAME, email: CONTACT_EMAIL },
};
---
<Base
  title="Contact Us"
  description="Questions about The Agency School courses, the contractor team or your purchase? Email us and we'll reply within two business days."
  schema={[contact]}
>
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p class="lead">Questions about the courses, the contractor team or an order? Send us an email.</p>
    </div>
    <section class="prose" style="padding-top:28px">
      <div class="box">
        <h2 style="margin-top:0">Email</h2>
        <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
        <p>We reply within two business days.</p>
      </div>
      <p style="margin-top:24px">Before you write, the <a href="/faq/">FAQ</a> may already have your answer.</p>
    </section>
  </div>
</Base>
