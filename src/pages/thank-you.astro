---
import Base from '../layouts/Base.astro';
---
<Base title="Thank You" description="Thanks for signing up. Check your inbox for the free book and your webinar invite." noindex>
  <div class="wrap">
    <div class="page-head center" style="padding-block:80px">
      <p class="eyebrow">You're in</p>
      <h1>Check your inbox</h1>
      <p class="lead" style="margin-inline:auto">The free book and your webinar invite are on the way. If you don't see them in a few minutes, check your spam or promotions folder.</p>
      <p style="margin-top:28px"><a class="btn alt" href="/how-it-works/">See how it works</a></p>
    </div>
  </div>
</Base>
